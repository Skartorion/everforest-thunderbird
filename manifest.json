{
  "manifest_version": 2,
  "name": "Everforest Dark Medium",
  "version": "3.0.1",
  "description": "Everforest Dark Medium theme for Thunderbird",
  "author": "Skartorion; based on Everforest Night by jarith",
  "homepage_url": "https://github.com/Skartorion/everforest-thunderbird",
  "developer": {
    "name": "Skartorion",
    "url": "https://github.com/Skartorion/everforest-thunderbird"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "everforest-dark-medium@skartorion",
      "strict_max_version": "159.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png"
  },
  "theme_experiment": {
    "stylesheet": "chrome.css",
    "colors": {
      "everforest_bg_dim": "--ef-bg-dim",
      "everforest_bg0": "--ef-bg0",
      "everforest_bg1": "--ef-bg1",
      "everforest_bg2": "--ef-bg2",
      "everforest_bg3": "--ef-bg3",
      "everforest_bg4": "--ef-bg4",
      "everforest_bg5": "--ef-bg5",
      "everforest_bg_visual": "--ef-bg-visual",
      "everforest_bg_red": "--ef-bg-red",
      "everforest_bg_yellow": "--ef-bg-yellow",
      "everforest_bg_green": "--ef-bg-green",
      "everforest_bg_blue": "--ef-bg-blue",
      "everforest_bg_purple": "--ef-bg-purple",
      "everforest_fg": "--ef-fg",
      "everforest_red": "--ef-red",
      "everforest_orange": "--ef-orange",
      "everforest_yellow": "--ef-yellow",
      "everforest_green": "--ef-green",
      "everforest_aqua": "--ef-aqua",
      "everforest_blue": "--ef-blue",
      "everforest_purple": "--ef-purple",
      "everforest_grey0": "--ef-grey0",
      "everforest_grey1": "--ef-grey1",
      "everforest_grey2": "--ef-grey2"
    }
  },
  "background": {
    "scripts": [
      "palette.js",
      "theme.js",
      "background.js"
    ]
  },
  "permissions": [
    "theme",
    "messagesRead",
    "compose",
    "scripting"
  ]
}
